# Shared runtime environment for Docker Compose and EC2 deployment.
# Copy to .env on the EC2 host and set real values before starting the stack.

# Backend / app web layer
JWT_SECRET_KEY=
JWT_EXPIRY_HOURS=24
FRONTEND_ORIGIN=http://localhost
KEYCLOAK_ENABLED=true
# Issuer is the public URL seen by the browser. JWKS can stay private inside Compose.
KEYCLOAK_ISSUER=http://localhost/auth/realms/learnmate
KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/learnmate/protocol/openid-connect/certs

# MongoDB
LEARNMATE_MONGODB_URI=mongodb://mongo:27017
LEARNMATE_MONGODB_DB=learnmate

# Qdrant
LEARNMATE_VECTOR_BACKEND=qdrant
LEARNMATE_QDRANT_URL=http://qdrant:6333
LEARNMATE_QDRANT_COLLECTION=learnmate_chunks
LEARNMATE_QDRANT_API_KEY=

# Models
LEARNMATE_MODELS_DIR=/app/models
LEARNMATE_GENERATOR_BACKEND=llamacpp
LEARNMATE_GENERATOR_MODEL=/app/models/qwen2.5-3b-instruct-q4_k_m.gguf
LEARNMATE_GENERATOR_N_CTX=4096
LEARNMATE_GENERATOR_API_URL=http://localhost:8001/v1
LEARNMATE_GENERATOR_API_KEY=
LEARNMATE_JUDGE_BACKEND=llamacpp
LEARNMATE_JUDGE_MODEL=/app/models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
LEARNMATE_JUDGE_N_CTX=8192
LEARNMATE_JUDGE_API_URL=http://localhost:8002/v1
LEARNMATE_JUDGE_API_KEY=
LEARNMATE_EMBEDDING_MODEL=all-MiniLM-L6-v2
LEARNMATE_N_THREADS=0
LEARNMATE_N_THREADS_BATCH=0
LEARNMATE_N_GPU_LAYERS=0
LEARNMATE_N_BATCH=512
LEARNMATE_FLASH_ATTN=0
LEARNMATE_USE_MLOCK=0

# Keycloak admin bootstrap
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Optional: keep for app startup/docs; do not commit real secrets
GEMINI_API_KEY=
HF_TOKEN=
