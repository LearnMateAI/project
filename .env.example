# The server's .env for the production stack (docker-compose.yml at the repo root).
#
# On EC2 this file is written by the deploy from the APP_ENV_FILE_B64 GitHub secret:
#     base64 -w 0 .env          (Linux)      base64 .env | tr -d '\n'     (macOS)
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes(".env"))        (PowerShell)
#
# Container wiring (database URLs, Keycloak issuer, CORS origin) is set in
# docker-compose.yml from PUBLIC_ORIGIN; it does not belong here.

# --- Where the site lives -------------------------------------------------------------------
PUBLIC_HOST=learnmateai.dinurag.dev
PUBLIC_ORIGIN=https://learnmateai.dinurag.dev
# Optional: Let's Encrypt expiry notices go here.
CERTBOT_EMAIL=

# --- Secrets: generate each with `openssl rand -hex 32` -----------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Only applied the first time Keycloak starts on an empty volume.
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# --- Models ----------------------------------------------------------------------------------
# Downloaded from Hugging Face into the model_data volume on first use (~4 GB, once).
LEARNMATE_GENERATOR_BACKEND=llamacpp
LEARNMATE_GENERATOR_MODEL=models/qwen2.5-3b-instruct-q4_k_m.gguf
LEARNMATE_GENERATOR_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF
LEARNMATE_GENERATOR_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
LEARNMATE_JUDGE_BACKEND=llamacpp
LEARNMATE_JUDGE_MODEL=models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
LEARNMATE_JUDGE_REPO=bartowski/Llama-3.2-3B-Instruct-GGUF
LEARNMATE_JUDGE_FILE=Llama-3.2-3B-Instruct-Q4_K_M.gguf
# Optional; both models are public. A token only lifts anonymous rate limits.
HF_TOKEN=

# CPU inference: one thread per vCPU (t3.xlarge has 4), no GPU layers.
LEARNMATE_N_THREADS=4
LEARNMATE_N_THREADS_BATCH=4
LEARNMATE_N_GPU_LAYERS=0
LEARNMATE_FLASH_ATTN=1

# --- Behaviour -------------------------------------------------------------------------------
LEARNMATE_VECTOR_BACKEND=qdrant
LEARNMATE_MAX_PDF_MB=10
LEARNMATE_MAX_PAGE_COUNT=300
# Load the embedder at start, and both GGUFs too, so the first question does not pay for it.
API_WARM_UP=1
API_WARM_MODELS=1
