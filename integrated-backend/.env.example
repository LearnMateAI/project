# Copy to .env and edit. Only JWT_SECRET_KEY has no working default -- everything else
# here shows the value the code uses when the variable is absent, so you can see what a
# setting is before deciding to change it.

# =========================================================================================
# WEB LAYER
# =========================================================================================

# Required. Signs the login tokens. No default on purpose: a fallback secret works in
# development, ships to production unnoticed, and makes every token it ever signed
# forgeable by anyone who has read the source. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# How long a login lasts.
JWT_EXPIRY_HOURS=24

# Where the browser is. Comma-separate to allow more than one origin.
FRONTEND_ORIGIN=http://localhost:5173

# Server-side password rule. The "at least one number" rule is not configurable.
# PASSWORD_MIN_LENGTH=8

# =========================================================================================
# DATABASES        docker compose up -d
# =========================================================================================

# MongoDB holds everything that is not a vector: the PDFs (GridFS), the cleaned page text,
# accounts, session bindings, chat history, generated resources, the evaluation log and the
# job queue. Losing this loses the corpus; losing Qdrant only costs a re-ingest.
#
# 27018 rather than 27017, because 27017 is often already answered by a native MongoDB
# service shared with other projects, and sharing a server means sharing a failure --
# another project's `docker compose down -v` would take this one's data with it.
LEARNMATE_MONGODB_URI=mongodb://localhost:27018
LEARNMATE_MONGODB_DB=learnmate

# Where the chunk embeddings live.
#   qdrant   a Qdrant server: a real HNSW index, filtering and scoring server-side. Default.
#   mongodb  keep them in MongoDB instead, so there is no second service to run.
# Switching does not migrate anything -- re-ingest to populate the new one.
LEARNMATE_VECTOR_BACKEND=qdrant

# A URL, never a directory: a path would run Qdrant inside this process and lock the
# directory, so only one process could hold the corpus. 6335 rather than 6333 for the same
# reason as the Mongo port above; docker-compose.yml publishes the matching port.
LEARNMATE_QDRANT_URL=http://localhost:6335
LEARNMATE_QDRANT_API_KEY=
LEARNMATE_QDRANT_COLLECTION=learnmate_chunks
# LEARNMATE_QDRANT_TIMEOUT=30
# LEARNMATE_QDRANT_BATCH_SIZE=128

# Only used when LEARNMATE_VECTOR_BACKEND=mongodb: the name of the Atlas vector index.
# Ignored off Atlas, where scoring falls back to exact NumPy cosine.
LEARNMATE_VECTOR_INDEX=chunk_vector_index

# =========================================================================================
# MODELS
# =========================================================================================
# Three backends, per role: "llamacpp" (a local GGUF, default), "http" (an
# OpenAI-compatible endpoint) or "gemini" (the Google API).
#
# Keep the generator and the judge on different model families whichever you pick. A judge
# sharing the generator's weights rates its own output style highly and the quality gate
# stops firing -- which looks like everything passing rather than like a broken evaluator.

# --- Generator: writes chat replies and study resources ----------------------------------
LEARNMATE_GENERATOR_BACKEND=llamacpp
LEARNMATE_GENERATOR_MODEL=models/qwen2.5-3b-instruct-q4_k_m.gguf
LEARNMATE_GENERATOR_N_CTX=4096
#
# Served over an OpenAI-compatible HTTP API instead:
# LEARNMATE_GENERATOR_BACKEND=http
# LEARNMATE_GENERATOR_API_URL=http://localhost:8001/v1
# LEARNMATE_GENERATOR_MODEL=learnmate-finetuned
# LEARNMATE_GENERATOR_API_KEY=
#
# Or through Gemini -- seconds instead of ~30, at the cost of sending the text off the
# machine. Set GEMINI_API_KEY below.
# LEARNMATE_GENERATOR_BACKEND=gemini
# LEARNMATE_GENERATOR_MODEL=gemini-2.0-flash

# Only needed if a finetune uses a prompt template llama.cpp cannot read from the GGUF
# metadata. Leave empty for anything finetuned from a standard base.
LEARNMATE_GENERATOR_CHAT_FORMAT=
# Where a missing GGUF is downloaded from, on first run only. Ignored once the file exists,
# so a hand-placed finetune is never overwritten.
# LEARNMATE_GENERATOR_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF
# LEARNMATE_GENERATOR_FILE=qwen2.5-3b-instruct-q4_k_m.gguf

# --- Judge: grades what the generator wrote ----------------------------------------------
LEARNMATE_JUDGE_BACKEND=llamacpp
LEARNMATE_JUDGE_MODEL=models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
# Larger than the generator's on purpose: the judge reads a resource *and* the passage it
# must be faithful to, so its input is the longer of the two.
LEARNMATE_JUDGE_N_CTX=8192
# LEARNMATE_JUDGE_BACKEND=gemini
# LEARNMATE_JUDGE_MODEL=gemini-2.0-flash-lite
# LEARNMATE_JUDGE_REPO=bartowski/Llama-3.2-3B-Instruct-GGUF
# LEARNMATE_JUDGE_FILE=Llama-3.2-3B-Instruct-Q4_K_M.gguf
# LEARNMATE_JUDGE_CHAT_FORMAT=

# Read only when a role's backend is "gemini".
GEMINI_API_KEY=

# Where the GGUF files live, and where a missing one is downloaded to.
# LEARNMATE_MODELS_DIR=models

# 0 lets llama.cpp auto-detect physical cores. Raise N_GPU_LAYERS to offload to a GPU.
LEARNMATE_N_THREADS=0
LEARNMATE_N_GPU_LAYERS=0

# =========================================================================================
# UPLOADS
# =========================================================================================
# Two limits on the same file, because size alone does not bound the work: a 3 MB scan of
# 800 pages is a small file and a very long ingest.
LEARNMATE_MAX_PDF_MB=10
LEARNMATE_MAX_PAGE_COUNT=300

# A session is about exactly one PDF: a second, different PDF ingested into the same
# session is refused, because embedding is the expensive step here. Set to 0 to allow a
# session to hold several.
LEARNMATE_ONE_PDF_PER_SESSION=1

# =========================================================================================
# RETRIEVAL AND GENERATION
# =========================================================================================
LEARNMATE_EMBEDDING_MODEL=all-MiniLM-L6-v2
LEARNMATE_CHUNK_SIZE=900
LEARNMATE_CHUNK_OVERLAP=150
LEARNMATE_TOP_K=4
# LEARNMATE_MIN_CHUNK_CHARS=80

# Cosine similarity below which the chat agent stops trusting the PDF and answers from
# general knowledge instead. This is what decides "pdf" vs "general" mode on a reply.
LEARNMATE_RELEVANCE_THRESHOLD=0.25

# Judge scores below this trigger exactly one regeneration. Raising MAX_ATTEMPTS is not
# just slower: a 3B judge tends to oscillate rather than converge over more rounds.
LEARNMATE_EVALUATOR_THRESHOLD=70
LEARNMATE_MAX_ATTEMPTS=2
LEARNMATE_MAX_HISTORY_TURNS=6
LEARNMATE_MAX_SOURCE_CHARS=6000

# Lifts anonymous rate limits when a model has to be downloaded from Hugging Face.
HF_TOKEN=
