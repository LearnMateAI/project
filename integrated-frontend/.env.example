# Copy to .env. Vite only exposes variables prefixed with VITE_ to the browser.

# Where the backend is.
#
# 8010 rather than 8000: port 8000 on this machine is answered by an unrelated
# `simplytask-backend` container. Uvicorn will still bind 127.0.0.1:8000 without
# complaining, but every request goes to the container instead and the API looks like it
# 404s on every route. Start the backend with:
#
#     cd integrated-backend && venv\Scripts\python -m uvicorn server:app --port 8010
#
# Whatever port you use here must also appear in integrated-backend/.env as
# FRONTEND_ORIGIN's counterpart -- that one is the *browser's* origin (http://localhost:5173),
# not this.
VITE_API_BASE_URL=http://localhost:8010

VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=learnmate
VITE_KEYCLOAK_CLIENT_ID=learnmate-frontend
